# GeoMemory configuration. Copy to .env (git-ignored) and fill in what you need:
#   cp .env.example .env
# Everything is optional. OPENROUTER_API_KEY is all live mode needs: Gemini 3.5 Flash on OpenRouter does
# every document model call (classifier, extractor, bh3 page reading, second reads, OCR of scans);
# OPENAI_API_KEY adds the chat assistant. Any one of the three keys gives live mode. With none, the app
# runs in demo mode:
# /api/health reports "demo" and uploads are refused with 409 demo_mode (browse, review and seed work).
# Keys are read only by the backend (api, worker, migrate). The web service and the test service never
# receive them. Never commit .env, never paste keys anywhere else.

# ---------------------------------------------------------------------------------------------
# Host ports published by docker compose (change them to run a second stack side by side)
# ---------------------------------------------------------------------------------------------
# nginx with the web app and the /api proxy: http://localhost:8080
WEB_PORT=8080
# FastAPI directly (OpenAPI docs at /docs)
API_PORT=8000
# PostgreSQL/PostGIS for local tools (user, password and database are all "geomemory")
DB_PORT=5432
# Tag of the locally built backend images; use a different value per checkout running its own stack
BACKEND_IMAGE_TAG=latest

# ---------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------
# docker compose pins DATABASE_URL, STORAGE_DIR and GOTENBERG_URL inside the containers, so these three
# lines only matter for tools you run on the host (make eval, alembic on the host). Defaults shown;
# on the host use @localhost:${DB_PORT} instead of @db:5432.
# DATABASE_URL=postgresql+asyncpg://geomemory:geomemory@db:5432/geomemory
# Uploaded originals, page images and OCR artifacts (a Docker volume in compose)
# STORAGE_DIR=/data/storage
# Gotenberg (LibreOffice) service that converts DOCX/DOC/ODT to PDF
# GOTENBERG_URL=http://gotenberg:3000

# Largest accepted upload in MB (larger files get 413)
MAX_UPLOAD_MB=200
# File types the upload accepts (the web drop zone mirrors this list from /api/health)
ACCEPTED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff,.docx,.xlsx,.csv
# Browser origins allowed by CORS, comma separated ("*" is not accepted)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Log level of api and worker (DEBUG, INFO, WARNING, ERROR). Secrets are never logged.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------
# Sign-in (email and password; the first account registered becomes admin)
# ---------------------------------------------------------------------------------------------
# true: every /api route except health, register and login needs a signed-in session. false is a local
# escape hatch: no sign-in at all, every change is recorded as "Local user".
AUTH_ENABLED=true
# "open": anyone who can reach the app may create an account. "closed": only the first account can be
# registered in the browser; create the others with: docker compose exec api python -m app.users create
AUTH_REGISTRATION=open
# true only when the app is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
# A ready account: with both set, the api creates this admin at startup (or sets its password again when it
# changed), so you can sign in at once. HACKATHON_EMAIL / HACKATHON_USERNAME and HACKATHON_PASSWORD work too.
# Use a password of 8 to 128 characters without "$", quotes or spaces.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Provider keys (secrets). Leave empty for demo mode.
# OPENROUTER_API_KEY alone runs every document call (Gemini 3.5 Flash); OPENAI_API_KEY runs the chat.
# ---------------------------------------------------------------------------------------------
# OpenRouter: the default provider of every document model call (Gemini 3.5 Flash: page classifier,
# extractor, bh3 page reading, second reads, sheet mapping, OCR of scanned pages with text boxes) and
# embeddings. OPEN_ROUTER_KEY is accepted as an alias; if you use the alias, delete this line (an empty
# OPENROUTER_API_KEY hides the alias).
OPENROUTER_API_KEY=
# OpenAI: chat assistant; also classifier, extractor and OCR when OpenRouter is not configured or
# refuses its key (see LLM_PROVIDER and OCR_PROVIDER)
OPENAI_API_KEY=
# Mistral (direct API): optional fallback only (OCR with block boxes and confidence, the models), used when
# OpenRouter and OpenAI are missing or refused, or when forced with LLM_PROVIDER / OCR_PROVIDER=mistral
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------------------------
# Provider settings
# ---------------------------------------------------------------------------------------------
# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent to OpenRouter as X-Title
OPENROUTER_APP_TITLE=GeoMemory
# Sent to OpenRouter as HTTP-Referer
OPENROUTER_APP_URL=http://localhost:8080
# OpenRouter provider routing: "deny" avoids providers that store or train on prompts ("allow" or "deny")
OPENROUTER_DATA_COLLECTION=deny
# Mistral API base URL
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OpenAI API base URL (the chat's openai SDK reads the same variable)
OPENAI_BASE_URL=https://api.openai.com/v1
# Provider of the classifier, extractor, second reads, spreadsheet mapping and bh3's page reading:
# "openrouter" (needs OPENROUTER_API_KEY), "openai" (needs OPENAI_API_KEY), "mistral" (needs MISTRAL_API_KEY)
# or "auto" (openrouter, then openai, then mistral: the first whose key is set; a refused key (401/403) moves
# every later call of the process to the next configured provider, until the worker restarts). Default: auto.
LLM_PROVIDER=auto
# OpenRouter model id of the page classifier (decides which pages get OCR)
CLASSIFIER_MODEL=google/gemini-3.5-flash
# OpenRouter model id of the structured extractor (also second reads and sheet mapping)
EXTRACTOR_MODEL=google/gemini-3.5-flash
# Mistral model ids of the classifier, the extractor and bh3's page reader (fallback; priced from
# backend/data/prices.yaml)
MISTRAL_CLASSIFIER_MODEL=mistral-small-latest
MISTRAL_EXTRACTOR_MODEL=mistral-medium-latest
MISTRAL_BH3_MODEL=mistral-medium-latest
# OpenAI model ids of the classifier and the extractor (empty: CHAT_MODEL). Costs are logged from
# backend/data/prices.yaml; a model missing there is logged with cost 0.
OPENAI_CLASSIFIER_MODEL=
OPENAI_EXTRACTOR_MODEL=
# Extraction of log pages: "bh3" (the page is read as a picture by a vision model, depths anchored to the
# depth scale; vector pages are parsed from their text layer without a model call) or "classic" (the
# OCR-text extractor above). bh3 hands any page it cannot read to classic. Default: bh3.
EXTRACTOR=bh3
# Vision model bh3 reads pages with: OpenRouter model id, and OpenAI model id (empty: CHAT_MODEL)
BH3_MODEL=google/gemini-3.5-flash
OPENAI_BH3_MODEL=
# OpenRouter vision model of the "openrouter_vision" OCR route: reads each scanned page render and returns
# its text as blocks with boxes (prompt: backend/data/prompts/ocr_boxes.txt)
OPENROUTER_OCR_MODEL=google/gemini-3.5-flash
# Mistral OCR model id
MISTRAL_OCR_MODEL=mistral-ocr-latest
# OpenAI vision model id that transcribes page images on the "openai" OCR route (empty: CHAT_MODEL)
OPENAI_OCR_MODEL=
# OCR route: "openrouter_vision" (OPENROUTER_OCR_MODEL reads the page render; text blocks with boxes, about
# 0.01-0.05 USD per page), "mistral" (direct API with MISTRAL_API_KEY; block boxes and confidence),
# "openrouter" (Mistral OCR via the OpenRouter file-parser plugin; text only, about 2 USD per 1,000 pages),
# "openai" (OPENAI_OCR_MODEL transcribes each page render with the prompt in
# backend/data/prompts/ocr_transcribe.txt; text only) or "auto" (openrouter_vision -> mistral -> openrouter
# -> openai, the first whose key is set; a refused key (401/403) moves on to the next configured route for
# the rest of the run and of the process). On the text-only routes, pages with a text layer still get
# word-level boxes. Default: auto.
OCR_PROVIDER=auto
# With OCR_PROVIDER=auto: "openrouter" lets auto also use the text-only routes (openrouter, openai) when the
# routes with boxes are missing or refused; "none" keeps auto on openrouter_vision and mistral only
OCR_FALLBACK=openrouter
# Reasoning for the classifier/extractor: off | low | medium | high (OpenRouter "reasoning", OpenAI
# "reasoning_effort"). Off keeps answers short and cheap; reasoning tokens count against the output limit.
# A model that cannot run with reasoning off (Gemini 3.5 Flash; list in backend/data/reasoning.yaml, and
# any model that answers "Reasoning is mandatory") gets effort "low" plus room for it in the answer.
LLM_REASONING=off
# OpenAI model id of the chat assistant (Responses API); also the default OpenAI classifier, extractor and
# OCR model
CHAT_MODEL=gpt-6.1-sol
# OpenRouter embedding model id (narrative search in chat)
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ---------------------------------------------------------------------------------------------
# Local models (Ollama): docker compose --profile ollama up --build
# ---------------------------------------------------------------------------------------------
# The "openai" route speaks the OpenAI-compatible chat-completions API to OPENAI_BASE_URL, so pointing it
# at the bundled ollama service runs the classifier, the extractor, bh3's page reading and OCR on local
# models. Pull a vision model once (docker compose exec ollama ollama pull <model>), then uncomment:
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# LLM_PROVIDER=openai
# OCR_PROVIDER=openai
# CHAT_MODEL=<the pulled model; also the default of the OPENAI_*_MODEL ids above>
# REQUEST_TIMEOUT_S=600
# GEOCODER=none

# ---------------------------------------------------------------------------------------------
# Pipeline thresholds and limits
# ---------------------------------------------------------------------------------------------
# Page roles that are sent to OCR; all other pages are only classified
IMPORTANT_PAGE_ROLES=log_sheet,log_continuation,summary_table,coordinate_table,lab_results,legend_or_key
# Classifier confidence below this: the page is re-labelled with the extractor model
CLASSIFIER_MIN_CONFIDENCE=0.6
# OCR block confidence below this: the value gets a second read
OCR_LOW_CONFIDENCE=0.75
# Confidence at or above which a value counts as clean for "approve clean"
CLEAN_CONFIDENCE=0.9
# Pages per Mistral OCR request (chunking)
OCR_MAX_PAGES_PER_REQUEST=8
# Largest OCR request body in MB (chunking)
OCR_MAX_REQUEST_MB=20
# Largest extractor input in tokens per request
EXTRACT_MAX_INPUT_TOKENS=200000
# Concurrent classifier calls per worker
CONCURRENCY_CLASSIFY=8
# Concurrent OCR calls per worker
CONCURRENCY_OCR=4
# Concurrent extractor calls per worker
CONCURRENCY_EXTRACT=4
# OCR requests in flight at once on the OpenRouter route, per worker (OpenRouter rate-limits bursts)
OCR_OPENROUTER_CONCURRENCY=1
# Rate limits (HTTP 429): seconds of waiting per provider call (Retry-After honoured, else backoff) before
# the call gives up; an OCR page still refused is tried again later in the same job, after a cooldown that
# grows each round, this many more times. Only then is it left unread (the document says so; retry reads it).
RATE_LIMIT_WAIT_S=150
OCR_RATE_LIMIT_ROUNDS=2
OCR_RATE_LIMIT_COOLDOWN_S=30

# ---------------------------------------------------------------------------------------------
# Geocoding
# ---------------------------------------------------------------------------------------------
# Place search for the map: "nominatim" (server proxy, 1 request/s, cached) or "none"
GEOCODER=nominatim
# Nominatim base URL
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identifying User-Agent required by the Nominatim usage policy; put a real contact in it
GEOCODER_USER_AGENT="GeoMemory/1.0 (contact: set-me)"

# ---------------------------------------------------------------------------------------------
# Cost logging
# ---------------------------------------------------------------------------------------------
# Price table used to log the cost of every provider call. The default (backend/data/prices.yaml)
# is resolved from the backend package and works on the host and in the image; set an absolute
# path only to use another table.
# PRICE_TABLE=backend/data/prices.yaml
# Hard cap in USD on the summed cost of all paid provider calls (classifier, OCR, extraction).
# When reached, processing stops with a readable reason instead of calling the provider. Empty = no cap.
# The cap sums the provider_calls table: deleting documents keeps it, wiping the database volume resets it.
PROVIDER_BUDGET_USD=

# ---------------------------------------------------------------------------------------------
# Evaluation (make eval). Host paths, used only by the evaluation run on the host, never by the stack.
# The eval runs the real pipeline with the keys above and stops at EVAL_MAX_USD.
# ---------------------------------------------------------------------------------------------
# Folder with the sample files to evaluate (git-ignored, never inside the repository)
EVAL_DATA_DIR=
# Expected results per file (for example the data audit's summaries.json, outside the repository)
EVAL_EXPECTED=
# Cost cap of one eval run in USD
EVAL_MAX_USD=1
