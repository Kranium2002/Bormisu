# --- model backend (OpenAI-compatible chat API) -----------------------------
# Both pipelines speak only the OpenAI chat-completions surface, so the backend is a URL + model name.
# Put the real key in .env (gitignored). NEVER commit a key into this file.

# Profile 1 - Mistral API (hosted; the stop-gap while no local GPU is available)
MISTRAL_API_KEY=your-key-here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest                # text model: layer normalisation, header fallback
LLM_VISION_MODEL=mistral-medium-latest        # vision model for bh3 (pixtral-large is retired)

# Profile 2 - on-prem vLLM (customer servers). Serve e.g. Mistral-Small-3.2 (open weights, vision) or Qwen2.5-VL:
#   vllm serve mistralai/Mistral-Small-3.2-24B-Instruct-2506 --tokenizer-mode mistral --limit-mm-per-prompt image=2
# LLM_BASE_URL=http://gpu-host:8000/v1
# LLM_API_KEY=anything
# LLM_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
# LLM_VISION_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
# LLM_JSON_SCHEMA=1                            # vLLM supports response_format=json_schema (guided decoding)

# Profile 3 - Ollama / LM Studio / llama.cpp server on a workstation
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=mistral-small3.2
# LLM_VISION_MODEL=qwen2.5vl:7b
# LLM_JSON_SCHEMA=0                            # set 0 if the server rejects response_format=json_schema

# Run `python -m bh3 probe` after changing the backend: it lists the server's models, sends a real
# scanned page at several resolutions and reports schema support, latency and token use.

# --- bh3 ----------------------------------------------------------------
BH_VLM_DPI=200            # render resolution for extraction tiles
BH_VLM_TILE_PX=1540       # long-side cap of a tile; measured: Mistral downscales anything larger anyway
BH_VLM_WORKERS=4          # parallel vision calls per page
BH_VLM_MAX_TOKENS=4096    # answer budget per tile (truncated tiles are split and re-read)
BH_VLM_SYMBOLS=auto       # auto | always | never: second read naming the hatch symbol + legend of strata drawn without words
BH_VLM_TRANSCRIPT=1       # 0 = do not pass a vector page's embedded text to the model (used to replay old cached answers)
# BH_PROMPT_VERSION=2     # replay answers cached under an older prompt version (no new model calls); normally unset

# --- shared -----------------------------------------------------------------
LLM_CACHE_DIR=.llm_cache
LLM_BATCH=25
# Corporate TLS interception (e.g. Avast Web Shield): point Python at a bundle that contains that root:
# SSL_CERT_FILE=C:/path/to/ca-bundle.pem

# --- bh3 geometry anchoring (grid overlay + ruling-line snapping) ---------
BH_VLM_ANCHOR=1            # 0 = depths exactly as the model read them
BH_ANCHOR_REQUIRE_SNAP=1   # a boundary is re-anchored only if its grid position hits a detected ruling line
BH_ANCHOR_MAX_SHIFT=0.75   # m: largest change an anchored boundary may make to the model's depth
BH_ANCHOR_POINT_SHIFT=0.3  # m: same for SPT / sample / water depths (measured: 0.3 lifts SPT recall, larger values hurt)
