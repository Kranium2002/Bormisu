# Copy to .env.local and adjust. Never put API keys in the frontend: it has none.

# Where the app gets its data:
#   api    (default) talks to the FastAPI backend under VITE_API_BASE
#   sample fictional demo data from src/sample/, no backend needed
#          (`npm run dev:sample` sets this via .env.sample)
VITE_DATA_SOURCE=api

# First map focus of the Map screen (users switch it at runtime with the MAP FOCUS dropdown):
#   world  (default) every borehole with coordinates, no restriction
#   DE     a preset country, by ISO 3166-1 alpha-2 code (DE, CH, NO, ...): only its boreholes,
#          everything outside it masked, the view kept on it
# A ?focus=DE or ?focus=world parameter in the URL wins over this value.
VITE_MAP_FOCUS=world

# Base path of the backend API, as seen from the browser.
VITE_API_BASE=/api/v1

# Dev server only: where Vite proxies /api to.
# The bh3 backend (branch felix-integration): `cd backend && python -m bh3 api --store api_data --port 8000`
# (see docs/INTEGRATION.md §0); the arav/dev backend listens on the same port by default.
VITE_API_PROXY=http://127.0.0.1:8000
