# Copy to .env.local and adjust. Never put API keys in the frontend: it has none.
# Every value here is public: Vite writes VITE_* variables into the built JavaScript.
# The Docker image takes VITE_APP_NAME, VITE_TILE_URL and VITE_TILE_ATTRIBUTION as build args;
# it ignores .env files and always builds in API mode.

# Where the app gets its data:
#   api    (default) talks to the FastAPI backend under VITE_API_BASE
#   sample fictional demo data from src/sample/, no backend needed
#          (`npm run dev:sample` sets this via .env.sample)
VITE_DATA_SOURCE=api

# Base path of the backend API, as seen from the browser.
VITE_API_BASE=/api/v1

# Dev server only: where Vite proxies /api to.
VITE_API_PROXY=http://127.0.0.1:8000

# Product name in the UI and the browser tab. Empty: "Bormisu".
VITE_APP_NAME=

# Basemap tile URL template ({z}/{x}/{y}, optional {s}). Empty: the OpenStreetMap standard tiles
# (https://tile.openstreetmap.org/{z}/{x}/{y}.png), whose usage policy suits light use only.
VITE_TILE_URL=

# Attribution the tile source requires, as HTML. Empty: the OpenStreetMap attribution.
# Set it whenever VITE_TILE_URL points to another source.
VITE_TILE_ATTRIBUTION=
