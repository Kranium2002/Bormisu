# Copy to .env.local and adjust. Never put API keys in the frontend: it has none.

# Where the app gets its data:
#   api    (default) talks to the FastAPI backend under VITE_API_BASE
#   sample fictional demo data from src/sample/, no backend needed
#          (`npm run dev:sample` sets this via .env.sample)
VITE_DATA_SOURCE=api

# Base path of the backend API, as seen from the browser.
VITE_API_BASE=/api/v1

# Dev server only: where Vite proxies /api to.
VITE_API_PROXY=http://127.0.0.1:8000
