    "react-router": "8.4.0",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
